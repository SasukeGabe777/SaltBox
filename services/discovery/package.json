{
  "name": "@saltbox/discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "exports": {
    ".": "./src/types.ts",
    "./openstreetmap": "./src/adapters/openstreetmap.ts",
    "./overture": "./src/adapters/overture.ts",
    "./orchestrator": "./src/application/discover-and-qualify.ts"
  },
  "scripts": {
    "discover": "node scripts/discover.ts",
    "data": "node scripts/build-overture-extract.ts",
    "compare": "node scripts/compare.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"testing/**/*.test.ts\""
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@saltbox/database": "workspace:*",
    "@saltbox/prospecting": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "5.9.3"
  }
}
