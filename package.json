{
  "name": "saltbox",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "pnpm dev:website",
    "dev:website": "pnpm --filter @saltbox/website dev",
    "build": "pnpm build:website",
    "build:website": "pnpm --filter @saltbox/website build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "db:up": "pnpm --filter @saltbox/database db:up",
    "db:down": "pnpm --filter @saltbox/database db:down",
    "db:migrate": "pnpm --filter @saltbox/database db:migrate",
    "db:migrate:create": "pnpm --filter @saltbox/database db:migrate:create",
    "db:codegen": "pnpm --filter @saltbox/database db:codegen",
    "db:verify": "pnpm --filter @saltbox/database db:verify",
    "prospect:qualify": "pnpm --filter @saltbox/prospecting qualify"
  }
}
