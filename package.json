{
  "name": "saltbox",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "pnpm dev:website",
    "dev:website": "pnpm --filter @saltbox/website dev",
    "admin:dev": "pnpm --filter @saltbox/admin dev",
    "admin:build": "pnpm --filter @saltbox/admin build",
    "admin:check": "pnpm --filter @saltbox/admin check",
    "admin:test": "pnpm --filter @saltbox/admin test",
    "discover": "pnpm --filter @saltbox/discovery discover",
    "acquire": "pnpm --filter @saltbox/discovery acquire",
    "discovery:data": "pnpm --filter @saltbox/discovery data",
    "discovery:compare": "pnpm --filter @saltbox/discovery compare",
    "website:intelligence": "pnpm --filter @saltbox/website-intelligence intelligence",
    "demo:generate": "pnpm --filter @saltbox/demo-generation generate",
    "demo:brand": "pnpm --filter @saltbox/demo-generation brand",
    "demo:qa": "pnpm --filter @saltbox/demos qa",
    "demos:dev": "pnpm --filter @saltbox/demos dev",
    "demos:start": "pnpm --filter @saltbox/demos start",
    "build": "pnpm -r build",
    "build:website": "pnpm --filter @saltbox/website build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "db:up": "pnpm --filter @saltbox/database db:up",
    "db:down": "pnpm --filter @saltbox/database db:down",
    "db:migrate": "pnpm --filter @saltbox/database db:migrate",
    "db:migrate:create": "pnpm --filter @saltbox/database db:migrate:create",
    "db:codegen": "pnpm --filter @saltbox/database db:codegen",
    "db:verify": "pnpm --filter @saltbox/database db:verify",
    "prospect:qualify": "pnpm --filter @saltbox/prospecting qualify"
  }
}
