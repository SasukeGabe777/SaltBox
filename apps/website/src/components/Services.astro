---
import { services } from "../data/site";
---

<section class="services" id="services" aria-labelledby="services-heading">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">What we do</span>
      <h2 class="sec-h2" id="services-heading">Three things,<br />done right.</h2>
    </div>
    <div class="pillars">
      {services.map((service) => (
        <article class="pillar reveal">
          <div class="p-ic" aria-hidden="true">
            {service.icon === "brand" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13.5" cy="6.5" r="2.5"></circle><circle cx="17" cy="13" r="2.5"></circle><circle cx="8.5" cy="7.5" r="2.5"></circle><circle cx="6.5" cy="14" r="2.5"></circle><path d="M12 22a10 10 0 1 1 0-20"></path>
              </svg>
            )}
            {service.icon === "website" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M7 6.5h.01M10 6.5h.01"></path>
              </svg>
            )}
            {service.icon === "care" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21s-7-4.6-9.2-9A5.1 5.1 0 0 1 12 6.6 5.1 5.1 0 0 1 21.2 12C19 16.4 12 21 12 21z"></path>
              </svg>
            )}
          </div>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services { position: relative; z-index: 2; padding: 130px 0; }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pillar {
    padding: 38px 34px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--ink-2);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.45s, background 0.45s;
  }
  .pillar:hover { border-color: rgba(42, 224, 138, 0.4); background: var(--ink-3); transform: translateY(-8px); }
  .p-ic {
    display: grid;
    width: 52px;
    height: 52px;
    margin-bottom: 26px;
    border-radius: 14px;
    background: rgba(42, 224, 138, 0.12);
    color: var(--green);
    place-items: center;
  }
  h3 { margin-bottom: 12px; font-family: var(--display); font-size: 1.55rem; font-weight: 700; letter-spacing: -0.02em; }
  p { color: var(--salt-dim); line-height: 1.62; }

  @media (max-width: 920px) {
    .services { padding: 74px 0; }
    .pillars { grid-template-columns: 1fr; }
  }
</style>
