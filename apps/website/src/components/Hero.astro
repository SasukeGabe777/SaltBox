---
import DemoBuildAnimation from "./DemoBuildAnimation.astro";
---

<div class="shell">
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="hero-text">
      <span class="eyebrow rise d1">Web design &amp; branding · Salt Lake City</span>
      <h1 class="rise d2" id="hero-title">
        Websites worth<br /><span class="kw" data-kinetic-word><span>showing off.</span></span>
      </h1>
      <p class="lead rise d3">
        Saltbox builds modern websites and branding for local shops, makers, and service pros —
        <b>and looks after them, too.</b> No agency runaround, no jargon.
      </p>
      <div class="cta-row rise d4">
        <button class="btn btn-primary magnetic" type="button" data-scroll="contact">
          <span class="btn-i">Get a free quote</span>
        </button>
        <button class="btn btn-ghost magnetic" type="button" data-scroll="work">
          <span class="btn-i">See our work</span>
        </button>
      </div>
      <div class="meta rise d5" aria-label="Saltbox service highlights">
        <span><i aria-hidden="true"></i>Free quote in 48h</span>
        <span><i aria-hidden="true"></i>Branding + care in one place</span>
      </div>
    </div>

    <DemoBuildAnimation />

    <div class="cue" aria-hidden="true"><span>Scroll</span><span class="bar"></span></div>
  </section>
</div>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const touchInput = matchMedia("(hover: none)").matches;

  if (hero && !reduceMotion) {
    const words = ["showing off.", "clicking.", "bragging about.", "coming back to."];
    const wordContainer = hero.querySelector<HTMLElement>("[data-kinetic-word]");
    const word = wordContainer?.querySelector<HTMLElement>("span");
    let wordIndex = 0;

    if (word) {
      const interval = window.setInterval(() => {
        wordIndex = (wordIndex + 1) % words.length;
        word.style.transition = "transform .45s cubic-bezier(.6,0,.2,1), opacity .45s, filter .45s";
        word.style.transform = "translateY(-110%)";
        word.style.opacity = "0";
        word.style.filter = "blur(6px)";

        window.setTimeout(() => {
          word.style.transition = "none";
          word.textContent = words[wordIndex];
          word.style.transform = "translateY(110%)";
          requestAnimationFrame(() => requestAnimationFrame(() => {
            word.style.transition = "transform .5s cubic-bezier(.2,.8,.2,1), opacity .5s, filter .5s";
            word.style.transform = "translateY(0)";
            word.style.opacity = "1";
            word.style.filter = "blur(0)";
          }));
        }, 460);
      }, 2600);

      addEventListener("pagehide", () => clearInterval(interval), { once: true });
    }
  }

  if (hero && !touchInput && !reduceMotion) {
    hero.querySelectorAll<HTMLElement>(".magnetic").forEach((button) => {
      const inner = button.querySelector<HTMLElement>(".btn-i") ?? button;
      button.addEventListener("mousemove", (event) => {
        const bounds = button.getBoundingClientRect();
        const x = event.clientX - bounds.left - bounds.width / 2;
        const y = event.clientY - bounds.top - bounds.height / 2;
        button.style.transform = `translate(${x * 0.25}px, ${y * 0.35}px)`;
        inner.style.transform = `translate(${x * 0.12}px, ${y * 0.18}px)`;
      });
      button.addEventListener("mouseleave", () => {
        button.style.transform = "";
        inner.style.transform = "";
      });
    });

    const stage = hero.querySelector<HTMLElement>("[data-demo-build]");
    const browser = hero.querySelector<HTMLElement>("#hero-browser");
    const rest = "rotateY(-8deg) rotateX(3deg)";
    if (stage && browser) {
      browser.style.transform = rest;
      stage.addEventListener("mousemove", (event) => {
        const bounds = stage.getBoundingClientRect();
        const x = (event.clientX - bounds.left) / bounds.width - 0.5;
        const y = (event.clientY - bounds.top) / bounds.height - 0.5;
        browser.style.transform = `rotateY(${-8 + x * 10}deg) rotateX(${3 - y * 8}deg)`;
      });
      stage.addEventListener("mouseleave", () => { browser.style.transform = rest; });
    }
  }
</script>

<style>
  .hero {
    display: grid;
    position: relative;
    grid-template-columns: 1fr 1.02fr;
    align-items: center;
    gap: 54px;
    min-height: calc(100vh - 84px);
    padding: 48px 0 76px;
  }

  .hero .eyebrow { margin-bottom: 28px; }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.9rem, 5.4vw, 4.7rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.04em;
  }

  .kw {
    display: inline-block;
    position: relative;
    overflow: hidden;
    max-width: 100%;
    height: 1.28em;
    color: var(--green);
    line-height: 1.05;
    vertical-align: top;
  }

  .kw span { display: block; white-space: nowrap; }

  .lead {
    max-width: 35ch;
    margin: 30px 0 38px;
    color: var(--salt-dim);
    font-size: 1.14rem;
    line-height: 1.62;
  }

  .lead b { color: var(--salt); font-weight: 600; }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 48px;
    color: var(--salt-dim);
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .meta span { display: flex; align-items: center; gap: 8px; }
  .meta i {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px var(--green);
  }

  .cue {
    display: flex;
    position: absolute;
    z-index: 2;
    bottom: 24px;
    left: 50%;
    flex-direction: column;
    align-items: center;
    gap: 9px;
    color: var(--salt-dim);
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .cue .bar { width: 1px; height: 34px; background: linear-gradient(var(--green), transparent); }

  @media (max-width: 920px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 44px;
      min-height: auto;
      padding: 34px 0 84px;
    }

    h1 { font-size: clamp(2.1rem, 8.4vw, 3.4rem); }
    .lead { max-width: 44ch; }
    .meta { gap: 20px 22px; }
    .cue { display: none; }
  }
</style>
