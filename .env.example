# DATABASE
# PostgreSQL connection string (ADR-005/006). When unset, database tooling and
# tests default to the local docker-compose instance started by `pnpm db:up`:
#   postgres://saltbox:saltbox@localhost:5433/saltbox
# Production/Neon URLs are server-side secrets and never belong in this file.
# DATABASE_URL=

# ===========================================
# AI / INFERENCE POLICY
# ===========================================

# Prefer deterministic processing whenever possible.
AI_LOCAL_ENABLED=true

# Paid inference should remain disabled by default.
AI_PAID_FALLBACK_ENABLED=false

# Example future local inference endpoint.
# LOCAL_MODEL_BASE_URL=

# Example future model identifiers.
# LOCAL_MODEL_FAST=
# LOCAL_MODEL_SMART=

# Optional paid model configuration.
# PAID_MODEL_PROVIDER=
# PAID_MODEL_NAME=
# PAID_MODEL_API_KEY=

# Optional cost controls.
# AI_MAX_COST_PER_PROSPECT_USD=
# AI_MAX_DAILY_COST_USD=

# DEMOS
# Local demo renderer (apps/demos). Loopback only; never expose externally
# without authentication. The admin uses the base URL for VIEW DEMO links.
# SALTBOX_DEMOS_PORT=5175
# SALTBOX_DEMOS_BASE_URL=http://127.0.0.1:5175
# Resolution mode of a local renderer process:
#   preview (default) - the demo's current version, for operator review
#   public            - ONLY the operator-approved version (hosted semantics)
# SALTBOX_DEMOS_MODE=preview

# OPERATOR (Phase 10)
# Identity recorded on approvals, rejections, and runs until authentication
# exists. Keep it meaningful; it appears in audit history.
# SALTBOX_OPERATOR_REF=local-operator
# Absolute path to the local run worker, if the admin cannot resolve it:
# SALTBOX_OPERATOR_WORKER=C:\dev\SaltBox\services\operator\scripts\worker.ts

# HOSTED DEMOS (Cloudflare Workers + R2 + Neon, ADR-003/005/006)
# Public origin of the deployed demo renderer; used to record durable demo
# URLs at publication time.
# SALTBOX_DEMOS_PUBLIC_BASE_URL=https://saltbox-demos.<account>.workers.dev
# R2 bucket that stores published demo assets (must match wrangler.toml).
# SALTBOX_R2_BUCKET=saltbox-demo-assets
# Override the wrangler executable used by deploy/publish tooling.
# SALTBOX_WRANGLER=wrangler
# Cloudflare credentials are NEVER stored here. Use `wrangler login`, or a
# CLOUDFLARE_API_TOKEN exported in the operator's own shell.
# The Worker reads PostgreSQL through its Hyperdrive binding; the remote
# connection string is a Cloudflare secret, not a repository value.

# EMAIL
# EMAIL_PROVIDER_API_KEY=

# AUTH
# AUTH_SECRET=

# BILLING
# STRIPE_SECRET_KEY=

# HOSTING
# Add hosting provider settings when a provider is selected.

# PROSPECTING / DATA PROVIDERS
# Add provider credentials when providers are selected.
