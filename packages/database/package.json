{
  "name": "@saltbox/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "db:codegen": "node scripts/codegen.mjs",
    "db:verify": "node scripts/codegen.mjs --verify",
    "check": "tsc --noEmit",
    "test": "node --test \"testing/**/*.test.ts\""
  },
  "dependencies": {
    "kysely": "^0.29.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "typescript": "5.9.3"
  }
}
